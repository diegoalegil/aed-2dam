<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
 <modelVersion>4.0.0</modelVersion>
 <groupId>es.ejemplo</groupId><artifactId>cinefest</artifactId><version>1.0.0</version>
 <!-- Ajustes generales: compilar con Java 21 y leer el código fuente en UTF-8 (tildes y ñ) -->
 <properties><maven.compiler.release>21</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
 <!-- Lista de librerías externas que Maven descarga (como añadir los .jar al proyecto) -->
 <dependencies>
 <!-- hibernate-core: el ORM, implementa JPA (EntityManager, JPQL, anotaciones). Sustituye al JDBC escrito a mano -->
  <dependency><groupId>org.hibernate.orm</groupId><artifactId>hibernate-core</artifactId><version>7.4.11.Final</version></dependency>
 <!-- hibernate-community-dialects: contiene el SQLiteDialect, que no viene en hibernate-core. Debe llevar la misma versión que hibernate-core -->
  <dependency><groupId>org.hibernate.orm</groupId><artifactId>hibernate-community-dialects</artifactId><version>7.4.11.Final</version></dependency>
 <!-- sqlite-jdbc: driver JDBC de SQLite (org.sqlite.JDBC); Hibernate lo usa por debajo para conectar -->
  <dependency><groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId><version>3.46.1.0</version></dependency>
 <!-- junit-jupiter: librería de tests JUnit 5; scope test = solo se usa al probar, no entra en la aplicación -->
  <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.11.4</version><scope>test</scope></dependency>
 </dependencies>
 <!-- Plugins de Maven: compiler compila el código y surefire ejecuta los tests con mvn test -->
 <build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version></plugin></plugins></build>
</project>
