<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.1">
 <persistence-unit name="autoescuelaPU" transaction-type="RESOURCE_LOCAL">
  <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
  <class>es.ejemplo.autoescuela.orm.entity.ProfesorEntity</class>
  <class>es.ejemplo.autoescuela.orm.entity.VehiculoEntity</class>
  <class>es.ejemplo.autoescuela.orm.entity.AlumnoEntity</class>
  <class>es.ejemplo.autoescuela.orm.entity.ClasePracticaEntity</class>
  <properties>
   <property name="jakarta.persistence.jdbc.driver" value="org.sqlite.JDBC"/>
   <property name="hibernate.dialect" value="org.hibernate.community.dialect.SQLiteDialect"/>
   <property name="hibernate.hbm2ddl.auto" value="validate"/>
   <property name="hibernate.show_sql" value="false"/>
  </properties>
 </persistence-unit>
</persistence>
